id: 1
name: "Main Scene"
sceneType: "scene_3d"
mainCamera: 2
maxValues:
  maxSubmeshes: 64
  maxTilemapTilesRect: 0
  maxTilemapTiles: 0
  maxExternalBuffers: 0
  maxSpriteFrames: 0
  maxBones: 0
scene:
  backgroundColor: [0.25, 0.45, 0.65, 1.0]
  shadowQuality: "high"
  lightState: "on"
  globalIlluminationIntensity: 0.3
  globalIlluminationColor: [1.0, 1.0, 1.0]
  ambientLight2DIntensity: 1.0
  ambientLight2DColor: [1.0, 1.0, 1.0]
  shadow2DQuality: "low"
  ssaoEnabled: true
  ssaoRadius: 0.6
  ssaoIntensity: 0.9
  ssaoBias: 0.02
# SSR and the HDR chain are mutually exclusive in RenderSystem::draw: the SSR composite
# owns the destination, so an outdoor preset that wants bloom, tone map, DOF, height fog
# and light shafts leaves it off. Turn it back on for a wet or studio scene.
  ssrEnabled: false
  ssrMaxDistance: 12.0
  ssrThickness: 0.5
  ssrMaxSteps: 64
  ssrIntensity: 0.7
  ssrBlur: 1.0
  gravity2D: [0.0, -9.81]
  gravity3D: [0.0, -9.81, 0.0]
  fixedResolutionEnabled: false
  fixedResolutionWidth: 640
  fixedResolutionHeight: 360
  fixedResolutionFilter: "nearest"
  enableUIEvents: "enabled"
  depthPrepassEnabled: true
  bloomEnabled: true
  bloomThreshold: 0.8
  bloomSoftKnee: 0.6
  bloomIntensity: 0.7
  bloomDirtIntensity: 0.04
  bloomMipLevels: 5
  tonemapEnabled: true
  tonemapMode: 0
  exposure: 1.0
  autoExposure: true
  autoExposureSpeed: 1.5
  autoExposureMinEV: -2.0
  autoExposureMaxEV: 2.0
  exposureCompensation: 0.15
  colorGradingEnabled: true
  colorGradingSaturation: 1.06
  colorGradingContrast: 1.05
  colorGradingBrightness: 0.0
  colorGradingHueShift: 0.0
  colorGradingTemperature: 0.06
  colorGradingTint: 0.0
  fxaaEnabled: true
entities:
  - type: "Entity"
    entity: 1
    name: "Sun"
    components:
      transform:
        position: [0.0, 10.0, 0.0]
        rotation: [1.0, 0.0, 0.0, 0.0]
        scale: [1.0, 1.0, 1.0]
        visible: true
        billboard: false
        fakeBillboard: false
        cylindricalBillboard: false
      light:
          type: "directional"
          direction: [-0.55, -0.30, 0.78]
          worldDirection: [-0.55, -0.30, 0.78]
          color: [1.0, 0.93, 0.82]
          range: 100.0
          intensity: 3.2
          innerConeCos: 0.76604444
          outerConeCos: 0.64278764
          spotMask: ~
          shadows: true
          automaticShadowCamera: true
          shadowBias: 0.002
          mapResolution: 2048
          shadowCameraNearFar: [0.3, 100.0]
          numShadowCascades: 3
  - type: "Entity"
    entity: 2
    name: "PlayerCamera"
    components:
      transform:
        position: [0.0, 3.0, -5.0]
        rotation: [1.0, 0.0, 0.0, 0.0]
        scale: [1.0, 1.0, 1.0]
        visible: true
        billboard: false
        fakeBillboard: false
        cylindricalBillboard: false
      camera:
        type: "camera_perspective"
        target: [0.0, 1.0, 0.0]
        up: [0.0, 1.0, 0.0]
        leftClip: 0.0
        rightClip: 0.0
        bottomClip: 0.0
        topClip: 0.0
        yfov: 1.05
        aspect: 1.778
        nearClip: 0.1
        farClip: 1000.0
        renderToTexture: false
        transparentSort: false
        useTarget: true
        autoResize: true
        framebufferWidth: 800
        framebufferHeight: 450
        framebufferFilter: "linear"
      script:
        scripts:
          - type: "lua"
            path: "scripts/third_person_camera.lua"
            enabled: true
            properties:
              - name: "distance"
                displayName: "Camera Distance"
                type: "Float"
                value: 6.0
                defaultValue: 6.0
              - name: "height"
                displayName: "Camera Height"
                type: "Float"
                value: 3.0
                defaultValue: 3.0
              - name: "followSpeed"
                displayName: "Follow Speed"
                type: "Float"
                value: 8.0
                defaultValue: 8.0
  - type: "Entity"
    entity: 3
    name: "Player"
    components:
      transform:
        position: [0, 0.9, 0]
        rotation: [1.0, 0.0, 0.0, 0.0]
        scale: [1, 1, 1]
        visible: true
        billboard: false
        fakeBillboard: false
        cylindricalBillboard: false
      mesh:
        buffer:
          type: vertex_buffer
          usage: immutable
          stride: 48
          size: 14976
          count: 312
          renderAttributes: true
          instanceBuffer: false
          attributes:
            - type: position
              dataType: float
              bufferName: ""
              elements: 3
              offset: 0
              count: 312
              normalized: true
              perInstance: false
            - type: texcoord1
              dataType: float
              bufferName: ""
              elements: 2
              offset: 12
              count: 312
              normalized: true
              perInstance: false
            - type: normal
              dataType: float
              bufferName: ""
              elements: 3
              offset: 20
              count: 312
              normalized: true
              perInstance: false
            - type: color
              dataType: float
              bufferName: ""
              elements: 4
              offset: 32
              count: 312
              normalized: true
              perInstance: false
          data: 
          vertexSize: 48
        indices:
          type: index_buffer
          usage: immutable
          stride: 2
          size: 3456
          count: 1728
          renderAttributes: true
          instanceBuffer: false
          attributes:
            - type: index
              dataType: unsigned_short
              bufferName: ""
              elements: 1
              offset: 0
              count: 1728
              normalized: true
              perInstance: false
          data: 
        eBuffers: ~
        submeshes:
          - material:
              baseColorFactor: [0.85, 0.45, 0.35, 1]
              metallicFactor: 0
              roughnessFactor: 0.7
              alphaCutoff: 0.5
              alphaMode: ALPHA_OPAQUE
              emissiveFactor: [0, 0, 0]
              name: ""
            textureRect: [0, 0, 1, 1]
            primitiveType: triangles
            vertexCount: 1728
            faceCulling: true
            textureShadow: false
            hasTexCoord1: true
            hasTexCoord2: false
            hasNormalMap: true
            hasTangent: false
            hasVertexColor3: false
            hasVertexColor4: true
            hasTextureRect: false
            hasSkinning: false
            hasMorphTarget: false
            hasMorphNormal: false
            hasMorphTangent: false
        aabb:
          min: [-0.3, -0.9, -0.3]
          max: [0.3, 0.9, 0.3]
        verticesAABB:
          min: [-0.3, -0.9, -0.3]
          max: [0.3, 0.9, 0.3]
        receiveLights: true
        receiveIBL: true
        castShadows: true
        receiveShadows: true
        renderInReflectionProbes: true
        transparent: false
        cullingMode: back
        windingOrder: ccw
      body3d:
        type: "kinematic"
        motionQuality: "discrete"
        sensor: false
        numShapes: 1
        shapes:
          - type: "capsule"
            position: [0.0, 0.0, 0.0]
            rotation: [1.0, 0.0, 0.0, 0.0]
            radius: 0.3
            halfHeight: 0.6
            density: 1.0
            source: "none"
      script:
        scripts:
          - type: "lua"
            path: "scripts/third_person_player.lua"
            enabled: true
            properties:
              - name: "moveSpeed"
                displayName: "Move Speed"
                type: "Float"
                value: 5.0
                defaultValue: 5.0
              - name: "rotationSpeed"
                displayName: "Rotation Speed"
                type: "Float"
                value: 10.0
                defaultValue: 10.0
