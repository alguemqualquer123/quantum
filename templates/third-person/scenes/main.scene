  taaVelocityClamp: 0.25
  motionBlurEnabled: false
  motionBlurIntensity: 1
  motionBlurSamples: 8
  motionBlurVelocityClamp: 0.08
  motionBlurDepthThreshold: 0.5
  gravity2D: [0, -9.81]
  gravity3D: [0, -9.81, 0]
  windEnabled: false
  windSpeed: 6
  windDirection: 0
  windGustiness: 0.35
  windChange: 0.2
  fixedResolutionEnabled: false
  fixedResolutionWidth: 640
  fixedResolutionHeight: 360
  fixedResolutionFilter: nearest
  bloomEnabled: true
  bloomThreshold: 1.1
  bloomSoftKnee: 0.6
  bloomIntensity: 0.45
  bloomDirtIntensity: 0.04
  bloomMipLevels: 5
  tonemapEnabled: true
  tonemapMode: 0
  exposure: 1
  autoExposure: true
  autoExposureSpeed: 1.5
  autoExposureMinEV: -2
  autoExposureMaxEV: 2
  exposureCompensation: 0.15
  colorGradingEnabled: true
  colorGradingSaturation: 1.06
  colorGradingContrast: 1.05
  colorGradingBrightness: 0
  colorGradingHueShift: 0
  colorGradingTemperature: 0.14
  colorGradingTint: 0
  fxaaEnabled: true
  fxaaIntensity: 1
  enableUIEvents: not_set
sceneType: scene_3d
mainCamera: 2
maxValues:
  maxSubmeshes: 1
  maxTilemapTilesRect: 0
  maxTilemapTiles: 0
  maxExternalBuffers: 0
  maxSpriteFrames: 0
  maxBones: 96
  maxShapes2D: 0
  maxShapePoints2D: 0
  maxShapes3D: 1
  maxShapeVertices3D: 0
  maxShapeIndices3D: 0
shaderKeys:
