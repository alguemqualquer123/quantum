id: 1
name: Main Scene
scene:
  backgroundColor: [0.25, 0.45, 0.65, 1]
  shadowQuality: high
  meshLodEnabled: true
  meshLodThreshold: 1
  depthPrepassEnabled: true
  renderDistance: 0
  lightState: on
  globalIlluminationIntensity: 0.52
  globalIlluminationColor: [1, 1, 1]
  ambientLight2DIntensity: 1
  ambientLight2DColor: [1, 1, 1]
  shadow2DQuality: low
  ssaoEnabled: true
  ssaoRadius: 0.6
  ssaoIntensity: 0.9
  ssaoBias: 0.02
  contactShadowsEnabled: false
  contactShadowLength: 0.35
  contactShadowSteps: 12
  contactShadowThickness: 0.025
  contactShadowIntensity: 0.65
  ssgiEnabled: false
  ssgiRadius: 2.5
  ssgiIntensity: 0.35
  ssgiSteps: 12
  ssgiThickness: 0.25
