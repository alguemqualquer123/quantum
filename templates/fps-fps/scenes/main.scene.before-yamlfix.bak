id: 1
name: Main Scene
scene:
  backgroundColor: [0.25, 0.45, 0.65, 1]
  shadowQuality: none
  meshLodEnabled: false
  meshLodThreshold: 1
  depthPrepassEnabled: true
  renderDistance: 0
  lightState: on
  globalIlluminationIntensity: 0.42
  globalIlluminationColor: [1, 1, 1]
  ambientLight2DIntensity: 1
  ambientLight2DColor: [1, 1, 1]
  shadow2DQuality: low
  ssaoEnabled: true
  ssaoRadius: 0.6
  ssaoIntensity: 0.9
  ssaoBias: 0.02
  dofEnabled: false
  dofFocusDistance: 8
  dofAperture: 2
  dofFocusRange: 4
  dofMaxBlur: 0.02
  ssrEnabled: false
  ssrMaxDistance: 12
  ssrThickness: 0.5
  ssrMaxSteps: 64
  ssrIntensity: 0.7
  ssrBlur: 1
  gravity2D: [0, -9.81]
  gravity3D: [0, -9.81, 0]
  fixedResolutionEnabled: true
  fixedResolutionWidth: 1280
  fixedResolutionHeight: 720
  fixedResolutionFilter: nearest
  bloomEnabled: true
  bloomThreshold: 1.1
  bloomSoftKnee: 0.6
  bloomIntensity: 0.45
  bloomDirtIntensity: 0.04
  bloomMipLevels: 5
  tonemapEnabled: true
  tonemapMode: 0
  exposure: 1
  autoExposure: true
  autoExposureSpeed: 1.5
  autoExposureMinEV: -2
  autoExposureMaxEV: 2
  exposureCompensation: 0.15
  colorGradingEnabled: true
  colorGradingSaturation: 1.06
  colorGradingContrast: 1.05
  colorGradingBrightness: 0
  colorGradingHueShift: 0
  colorGradingTemperature: 0.14
  colorGradingTint: 0
  fxaaEnabled: false
  fxaaIntensity: 1
  enableUIEvents: not_set
sceneType: scene_3d
mainCamera: 1002
maxValues:
  maxSubmeshes: 1
  maxTilemapTilesRect: 0
  maxTilemapTiles: 0
  maxExternalBuffers: 6
  maxSpriteFrames: 0
  maxBones: 128
  maxShapes2D: 0
  maxShapePoints2D: 0
  maxShapes3D: 1
  maxShapeVertices3D: 0
  maxShapeIndices3D: 0
