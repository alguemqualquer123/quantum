            - type: index
              dataType: unsigned_short
              bufferName: ""
              elements: 1
              offset: 0
              count: 1728
              normalized: true
              perInstance: false
          data: 
        eBuffers: ~
        submeshes:
          - material:
              baseColorFactor: [0.3, 0.55, 0.85, 1]
              metallicFactor: 0
              roughnessFactor: 0.7
              alphaCutoff: 0.5
              alphaMode: ALPHA_OPAQUE
              emissiveFactor: [0, 0, 0]
              name: ""
            textureRect: [0, 0, 1, 1]
            primitiveType: triangles
            vertexCount: 1728
            faceCulling: true
            textureShadow: false
            hasTexCoord1: true
            hasTexCoord2: false
            hasNormalMap: true
            hasTangent: false
            hasVertexColor3: false
            hasVertexColor4: true
            hasTextureRect: false
            hasSkinning: false
            hasMorphTarget: false
            hasMorphNormal: false
            hasMorphTangent: false
        aabb:
          min: [-0.35, -0.8, -0.35]
          max: [0.35, 0.8, 0.35]
        verticesAABB:
          min: [-0.35, -0.8, -0.35]
          max: [0.35, 0.8, 0.35]
        receiveLights: true
        receiveIBL: true
        castShadows: true
        receiveShadows: true
        renderInReflectionProbes: true
        transparent: false
        cullingMode: back
        windingOrder: ccw
      body3d:
        type: "kinematic"
        motionQuality: "discrete"
        sensor: false
        numShapes: 1
        shapes:
          - type: "capsule"
            position: [0.0, 0.0, 0.0]
            rotation: [1.0, 0.0, 0.0, 0.0]
            radius: 0.3
            halfHeight: 0.5
            density: 1.0
            source: "none"
      script:
        scripts:
          - type: "lua"
            path: "scripts/moba_player.lua"
            enabled: true
            properties:
              - name: "moveSpeed"
                displayName: "Move Speed"
                type: "Float"
                value: 4.0
                defaultValue: 4.0
              - name: "rotationSpeed"
                displayName: "Rotation Speed"
                type: "Float"
                value: 12.0
                defaultValue: 12.0
