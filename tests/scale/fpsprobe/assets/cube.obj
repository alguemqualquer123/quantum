# The cheapest mesh that still exercises the whole mesh pipeline: position + normal + uv, so the
# probe lands on a mesh_* variant that is already compiled. 24 corners because a cube needs a
# per-face normal; 12 triangles, no duplicated face.
v -1 -1  1
v -1 -1 -1
v -1  1 -1
v -1  1  1
v  1 -1  1
v  1 -1 -1
v  1  1 -1
v  1  1  1
vn  0  0  1
vn  0  0 -1
vn  1  0  0
vn -1  0  0
vn  0  1  0
vn  0 -1  0
vt 0 0
vt 1 0
vt 1 1
vt 0 1
f 1/1/1 5/2/1 8/3/1
f 1/1/1 8/3/1 4/4/1
f 2/1/2 3/2/2 7/3/2
f 2/1/2 7/3/2 6/4/2
f 5/1/3 6/2/3 7/3/3
f 5/1/3 7/3/3 8/4/3
f 1/1/4 4/2/4 3/3/4
f 1/1/4 3/3/4 2/4/4
f 4/1/5 8/2/5 7/3/5
f 4/1/5 7/3/5 3/4/5
f 1/1/6 2/2/6 6/3/6
f 1/1/6 6/3/6 5/4/6
